{
  "name": "vozchat-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "VozChat PWA com FlowTalk LiveKit gerenciado (integracao opcional)",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "postinstall": "npm run build:livekit && npm run build:calls && npm test",
    "build:livekit": "esbuild public/livekit-radio.js --bundle --minify --format=esm --platform=browser --target=es2020 --outfile=public/livekit.bundle.js",
    "build:calls": "esbuild public/call-client.js --bundle --minify --format=esm --platform=browser --target=es2020 --outfile=public/call.bundle.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "esbuild": "^0.25.12",
    "@livekit/protocol": "^1.53.0"
  }
}
